      "input": "{\"n\":[0,-0,-1,9007199254740991,-9007199254740991]}",
      "canonical": "{\"n\":[0,0,-1,9007199254740991,-9007199254740991]}",
      "sha256": "5373419475e33e2f0eeb81a1c16d55914a4f5140579af0177c89dd776a5a09d6"
    },
    {
      "name": "top-level array",
