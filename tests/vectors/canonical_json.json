{
  "description": "Cross-implementation vectors for the core's canonical JSON (RFC 8785 for integer-only documents with ASCII keys): msx/canonical_json.py. accept: input text, its canonical form and the SHA-256 of that form. reject: input text the strict reader refuses (floats, NaN, Infinity and duplicate keys; plain JSON allows some of them). base64: a byte blob and its padded RFC 4648 base64 string.",
  "accept": [
    {
      "name": "key order and whitespace",
      "input": "{ \"b\" : 2 ,\n\t\"a\" : 1 }",
      "canonical": "{\"a\":1,\"b\":2}",
      "sha256": "43258cff783fe7036d8a43033f830adfc60ec037382473548ac742b888292777"
    },
    {
      "name": "nested values and literals",
      "input": "{\"z\":[{\"y\":true,\"x\":false},null,[]],\"a\":{}}",
      "canonical": "{\"a\":{},\"z\":[{\"x\":false,\"y\":true},null,[]]}",
      "sha256": "ca20debc8758d1b3e04522b90e00aa5489e5da068e7d5668750d764efd07fe33"
    },
    {
      "name": "non-ASCII text stays raw UTF-8",
      "input": "{\"name\":\"\u30b2\u30fc\u30e0.rom\"}",
      "canonical": "{\"name\":\"\u30b2\u30fc\u30e0.rom\"}",
      "sha256": "856adc368fbce92932da0908a85ed43ef8145e29eb6c258866830cb20e6ce7f3"
    },
    {
      "name": "short escapes",
      "input": "{\"s\":\"\\\"\\\\\\b\\f\\n\\r\\t\"}",
      "canonical": "{\"s\":\"\\\"\\\\\\b\\f\\n\\r\\t\"}",
      "sha256": "b8a820fee44f5e71f6736e14fb2d82bcf1fb169f0c48cac32d32ccc0c4a98b51"
    },
    {
      "name": "other control characters as lowercase \\u00xx",
